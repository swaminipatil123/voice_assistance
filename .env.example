# ==============================================================================
# College Voice Assistant Environment Configuration
# ==============================================================================

# AI Service (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Telephony Provider (twilio / exotel / plivo / mock)
TELEPHONY_PROVIDER=twilio
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PHONE_NUMBER=

# Speech Services (STT: mock / whisper / google; TTS: gtts / mock)
STT_PROVIDER=mock
STT_API_KEY=
TTS_PROVIDER=gtts
TTS_API_KEY=

# Server Settings
HOST=0.0.0.0
PORT=5000
DEBUG=True
